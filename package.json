{
  "name": "ola-bot",
  "version": "0.1.0",
  "description": "Deterministic, auditable symptom-to-care-pathway engine with an integrated provider finder.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikaikahussey/ola.bot.git"
  },
  "keywords": [],
  "author": "OLA BOT contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ikaikahussey/ola.bot/issues"
  },
  "homepage": "https://github.com/ikaikahussey/ola.bot#readme",
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
